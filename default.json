{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate configuration for maya0513's repositories",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "abandonments:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * * * 2"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": false,
  "cloneSubmodules": true,
  "prHourlyLimit": 10,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "statusCheckWhen": {
    "artifactError": "always"
  },
  "rebaseWhen": "auto",
  "separateMajorMinor": true,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**",
    "**/.config/mise/locks/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 2"],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "minimumReleaseAge": null,
    "groupName": null
  },
  "packageRules": [
    {
      "description": "Automerge non-major updates using required platform checks, including 0.x releases",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Require manual review for major updates, including vulnerability fixes",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
